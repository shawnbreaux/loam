loam 0.0.1

# A 160 x 100 ft building pad on sloping ground: cut the high west half,
# push it into the low east half, top up from a stockpile, compact, finish.
# Coordinates are site-local feet; (0, 0) is the pad's south-west corner.

site pad_north {
  crs      "LOCAL:ft"                      # site-local grid; use an EPSG code for real jobs
  units    ft
  datum    "NAVD88"
  design   "pad_north_design.xml"   format landxml  surface "FG"
  existing "pad_north_existing.xml" format landxml  surface "EG"
  boundary rect (0, 0) (160, 100)
  grid     1 ft
}

probe overhead {        # where measured ground comes from: a lidar on a tethered drone
  kind        tethered_uav
  sensor      lidar
  rate        5 min             # a full survey of the site every 5 minutes
  accuracy    0.05 ft
  coverage    site
  stale_after 15 min            # no survey for this long: all machines hold
}

# The fleet. A machine's class says what work it can do; its width sets the width of a pass.
machine dz1 { class dozer;   blade 12 ft;  max_speed 3 mph }
machine dz2 { class dozer;   blade 10 ft;  max_speed 3 mph }
machine rl1 { class roller;  drum 7 ft;    max_speed 4 mph }

# Zones give areas a role. The whole pad must end within a tenth of a foot of design.
# A is the high side, to be cut. C is the low side, to be filled in 8 in lifts and compacted.
zone pad  { role finish;  area rect (0, 0) (160, 100);   tolerance ±0.1 ft }
zone A    { role cut;     area rect (0, 0) (85, 100);    tolerance ±0.1 ft }
zone C    { role fill;    area rect (85, 0) (160, 100);  tolerance ±0.1 ft
            lift 8 in;   compaction 95 % proctor }

# Fill kept beside the pad, measured in the pile.
stockpile sp1 { area rect (170, 0) (200, 40);  available 600 yd3;  material "select fill" }

# Tasks are goals with limits, not step-by-step instructions. The planner splits each into as many
# passes as it takes, and a task ends when its `until` condition holds on the measured ground.

# Cut zone A down to design, at most half a foot per pass.
task strip_A {
  op      cut
  zone    A
  by      class dozer
  max_cut 0.5 ft per pass
  spoil   -> [C, sp1]                # fill C first; overflow goes to the stockpile
  until   residual(A).high < 0.15 ft
}

# Bring C up to design from the stockpile, once the cut has supplied what it can.
task top_up_C {
  op     fill
  zone   C
  by     class dozer
  source [sp1]
  lift   8 in
  after  strip_A done
  until  residual(C).low > -0.15 ft and compaction(C) >= 95 %
}

# Roll each lift four times. Starts as soon as the cut starts placing material in C.
task compact_C {
  op     compact
  zone   C
  by     class roller
  passes 4
  after  strip_A start
  until  done(top_up_C) and compaction(C) >= 95 %
}

# Trim the whole pad to tolerance when the bulk work is done.
task finish_pad {
  op    finish
  zone  pad
  by    class dozer
  after strip_A done
  after top_up_C done
  source [sp1]                      # small low spots are topped up from the stockpile
  until in_tolerance(pad)
}

# Rules are checked all the time, whatever the tasks are doing.
#   stop   machines stop at once
#   hold   passes under way finish; no new ones start
#   pause  no new passes for the task named

rule people_near_machines {
  when proximity(person, machine) < 50 ft
  do   stop all
}

rule overhead_stale {
  when age(overhead) > 15 min
  do   hold all
}

rule rain {
  when weather(rain) > 0.25 in/h
  do   pause task compact_C
}

# When the measured ground differs from what the plan predicted by more than 0.15 ft, plan again from
# the measurement and re-estimate how much this soil swells and compacts.
replan drift {
  when deviation() > 0.15 ft
}
