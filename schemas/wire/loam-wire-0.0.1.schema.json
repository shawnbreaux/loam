{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/loam/wire/0.0.1/schema.json",
  "title": "Loam Wire 0.0.1 messages",
  "description": "Positions are in the site CRS (site units). Every other quantity is SI: metres, seconds, m/s, cubic metres.",
  "$defs": {
    "order": {
      "type": "object",
      "description": "loam/v0/<site>/<machine>/order \u2014 one unit of work for one machine. A new orderId replaces the previous order; a higher orderUpdateId amends it.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "orderUpdateId": {
          "type": "integer",
          "minimum": 0
        },
        "task": {
          "type": "string"
        },
        "op": {
          "enum": [
            "cut",
            "fill",
            "spread",
            "compact",
            "trench",
            "haul",
            "finish",
            "load"
          ]
        },
        "window": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Work area polygon; null when the work is defined by deposit/source only"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "The line the middle of the tool follows for the working part of the pass, in this order, site coordinates. Sent for a task that runs along a line. Without it the machine runs down the middle of the window along its longer side."
        },
        "swath": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "With a path: the width of ground the pass works, centred on the path, m. A blade is in the ground only within half of it of the path."
        },
        "target": {
          "type": "object",
          "description": "What the ground in the window should become",
          "oneOf": [
            {
              "properties": {
                "surface": {
                  "const": "design"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Leave cells within this distance of the design untouched, m"
                },
                "pattern": {
                  "type": "string",
                  "description": "Cut and finish orders: planned height change per grid cell over the window, m (negative = cut; float32-le-base64, row-major from the window's low corner). Grade control holds the blade to it and never cuts below design."
                },
                "shape": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 1},
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "surface"
              ]
            },
            {
              "properties": {
                "elevation": {
                  "type": "number"
                }
              },
              "required": [
                "elevation"
              ]
            },
            {
              "properties": {
                "offset": {
                  "type": "number"
                }
              },
              "required": [
                "offset"
              ]
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxCut": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lift": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "passes": {
              "type": "integer",
              "minimum": 1
            },
            "maxSpeed": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        },
        "deposit": {
          "type": "object",
          "properties": {
            "zone": {
              "type": "string"
            },
            "stockpile": {
              "type": "string"
            },
            "lift": {
              "type": "number"
            },
            "source": {
              "type": "string"
            },
            "overflow": {
              "type": "string",
              "description": "Stockpile for material that does not fit in the deposit window"
            },
            "volume": {
              "type": "number",
              "description": "Loose volume to place in the window, m3"
            },
            "pattern": {
              "type": "string",
              "description": "Planned loose thickness per grid cell over the window, m (float32-le-base64, row-major from the window's low corner)"
            },
            "shape": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "minItems": 2,
              "maxItems": 2
            },
            "planned": {
              "type": "number",
              "description": "Cut orders: all the loose spoil the planner expects, m3; the share not in the pattern goes to overflow"
            },
            "bank": {
              "type": "number",
              "description": "Fill orders: bank volume to take from the source, m3"
            },
            "window": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "machine",
        "orderId",
        "orderUpdateId",
        "task",
        "op",
        "target",
        "limits"
      ],
      "additionalProperties": false
    },
    "instantAction": {
      "type": "object",
      "description": "loam/v0/<site>/<machine>/instantAction \u2014 acted on immediately, ahead of any order.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "action": {
          "enum": [
            "stop",
            "hold",
            "resume",
            "slow"
          ]
        },
        "reason": {
          "type": "string"
        },
        "maxSpeed": {
          "type": "number"
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "machine",
        "action",
        "reason"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "description": "loam/v0/<site>/<machine>/state \u2014 published by the machine at 1 Hz or faster.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "orderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "pose": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "heading"
          ]
        },
        "driving": {
          "type": "boolean"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safetyState": {
          "description": "ok: may work. degraded: something accurate work needs is missing (an RTK fix); the controller sends no orders. stopped: at a standstill for a safety reason, named in errors.",
          "enum": [
            "ok",
            "degraded",
            "stopped"
          ]
        },
        "stopLatencyS": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds from a stop command (site stop, e-stop, lost heartbeat) to standstill; the slowest so far"
        },
        "tool": {
          "type": "object",
          "description": "Blade/bucket/drum pose if known",
          "additionalProperties": true
        },
        "gnss": {
          "type": "object",
          "description": "What the receiver said about its fix, when the state comes from one",
          "properties": {
            "fix": {"type": "string", "description": "rtk-fixed, rtk-float, dgps, gps, dead-reckoning, invalid, or the receiver's own quality number"},
            "sats": {"type": ["integer", "null"], "minimum": 0},
            "hdop": {"type": ["number", "null"], "minimum": 0},
            "age": {"type": ["number", "null"], "minimum": 0, "description": "Seconds since the last correction"}
          },
          "required": ["fix"],
          "additionalProperties": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "warning",
                  "fatal"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "machine",
        "pose",
        "driving",
        "safetyState"
      ],
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "description": "loam/v0/<site>/<machine>/connection \u2014 retained; also set as the MQTT last-will message with state 'connectionBroken'.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "connectionState": {
          "enum": [
            "online",
            "offline",
            "connectionBroken"
          ]
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "machine",
        "connectionState"
      ],
      "additionalProperties": false
    },
    "terrain": {
      "type": "object",
      "description": "loam/v0/<site>/terrain \u2014 a measured surface tile from a probe.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "probe": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "cell": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "encoding": {
          "enum": [
            "float32-le-base64",
            "laz-url"
          ]
        },
        "sigma": {
          "type": [
            "number",
            "null"
          ]
        },
        "data": {
          "type": [
            "string",
            "null"
          ],
          "description": "Heights in site units, row-major from origin; null when the tile is sent by reference or omitted from a log"
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "probe",
        "origin",
        "cell",
        "shape",
        "encoding"
      ],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "description": "loam/v0/<site>/safety: site-wide stop/hold/resume and a 1 Hz heartbeat. A machine that receives nothing on this topic for 3 s stops on its own.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "command": {
          "enum": [
            "heartbeat",
            "stop",
            "hold",
            "resume"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "command"
      ],
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "description": "loam/v0/<site>/detection \u2014 a site sensor saw someone. One detection per sensor is current; kind 'clear' ends it.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "sensor": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "person",
            "unknown",
            "clear"
          ],
          "description": "'unknown': the sensor cannot say who is where (it may have failed); treated as a person."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "Site units. The person is within this distance of (x, y)."
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "sensor",
        "kind",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "weather": {
      "type": "object",
      "description": "loam/v0/<site>/weather \u2014 a weather reading.",
      "properties": {
        "version": {
          "type": "string",
          "const": "0.0.1"
        },
        "headerId": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "site": {
          "type": "string"
        },
        "sensor": {
          "type": "string"
        },
        "rain": {
          "type": "number",
          "minimum": 0,
          "description": "Rain rate, m/s."
        }
      },
      "required": [
        "version",
        "headerId",
        "timestamp",
        "site",
        "sensor",
        "rain"
      ],
      "additionalProperties": false
    },
    "estop": {
      "type": "object",
      "description": "loam/v0/<site>/estop \u2014 the site e-stop. Machines stop on pressed=true without waiting for the controller; released restarts nothing. Only 'pressed' is required, so the simplest radio can send it.",
      "properties": {
        "site": {
          "type": "string"
        },
        "pressed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "pressed"
      ]
    },
      "status": {
        "type": "object",
        "description": "loam/v0/<site>/status \u2014 the controller's summary for monitors (retained). Fields may be added.",
        "properties": {
          "version": {
            "type": "string",
            "const": "0.0.1"
          },
          "headerId": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "site": {
            "type": "string"
          },
          "t": {
            "type": "number",
            "description": "Site time in minutes"
          },
          "tasks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "started": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "done": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "passes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "started",
                "done",
                "passes"
              ]
            }
          },
          "machines": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "conn": {
                  "type": "string"
                },
                "safety": {
                  "type": "string"
                },
                "ready": {
                  "type": "boolean"
                },
                "clock_skew_s": {
                  "type": "number"
                },
                "order": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "conn",
                "safety",
                "ready"
              ]
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Rules and built-in holds in force"
          },
          "estop": {
            "type": "boolean"
          },
          "replans": {
            "type": "integer",
            "minimum": 0
          },
          "surveys": {
            "type": "integer",
            "minimum": 0
          },
          "probe_age_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "abandoned": {
            "type": "integer",
            "minimum": 0
          },
          "soil": {
            "type": "object",
            "properties": {
              "swell": {
                "type": "number"
              },
              "keep": {
                "type": "number"
              }
            }
          },
          "measured": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            },
            "description": "Per finish zone: percent of measured cells within tolerance"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "headerId",
          "timestamp",
          "site",
          "t",
          "tasks",
          "machines",
          "rules",
          "estop",
          "done"
        ],
        "additionalProperties": true
      }
  }
}